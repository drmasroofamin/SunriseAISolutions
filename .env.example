# Copy to .env.server.local. Keep that file private and out of Git.
# Use a Google App Password, NOT your regular Gmail password.
SMTP_USER=sunrisesolution93@gmail.com
SMTP_APP_PASSWORD=
# For a custom domain or non-Vercel host, use the exact public website origin.
# Leave blank locally or on Vercel: trusted platform hostnames are detected automatically.
APP_ORIGIN=
# AI chat: create a key in your OpenAI Platform account and keep it server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
